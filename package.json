{
  "name": "standardized-skills-api",
  "version": "1.0.0",
  "packageManager": "pnpm@11.15.1",
  "main": "dist/main.js",
  "description": "API endpoints for accessing the new standardized skills across Topcoder",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "lint": "eslint 'src/**/*.ts'",
    "test": "node -r ts-node/register --test 'src/**/*.spec.ts'",
    "format": "eslint 'src/**/*.ts' --fix",
    "pretty": "prettier --write \"src/**/*.ts\"",
    "services:up": "cd ./local && docker-compose up -d",
    "prisma:generate": "pnpm exec prisma generate",
    "prisma:migrate:deploy": "pnpm exec prisma migrate deploy",
    "prisma:studio": "pnpm exec prisma studio",
    "rebuild:win:summary": "pnpm exec ts-node --transpile-only -r tsconfig-paths/register src/scripts/rebuild-win-summary.ts",
    "test:dependency-compat": "node --test tools/minimatch-compat/index.test.cjs"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.10",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.27",
    "@types/node": "^25.9.9",
    "@types/superagent": "^8.1.11",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.130",
    "@aws-sdk/credential-providers": "^3.1161.0",
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@prisma/client": "6.19.3",
    "ai": "^7.0.159",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^17.4.2",
    "http-status-codes": "^2.3.0",
    "lodash": "4.18.1",
    "pg": "^8.23.1",
    "prisma": "6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "superagent": "^10.4.1",
    "tc-core-library-js": "https://codeload.github.com/topcoder-platform/tc-core-library-js/tar.gz/58de37670180e183e8378c3d203df0112a0414f6",
    "winston": "^3.19.0"
  }
}
