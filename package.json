{
  "name": "standardized-skills-api",
  "version": "1.0.0",
  "packageManager": "pnpm@9.6.0",
  "main": "dist/main.js",
  "description": "API endpoints for accessing the new standardized skills across Topcoder",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "lint": "eslint 'src/**/*.ts'",
    "format": "eslint 'src/**/*.ts' --fix",
    "pretty": "prettier --write \"src/**/*.ts\"",
    "services:up": "cd ./local && docker-compose up -d",
    "prisma:generate": "pnpm exec prisma generate",
    "prisma:migrate:deploy": "pnpm exec prisma migrate deploy",
    "prisma:studio": "pnpm exec prisma studio",
    "rebuild:win:summary": "pnpm exec ts-node --transpile-only -r tsconfig-paths/register src/scripts/rebuild-win-summary.ts"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.8",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.21",
    "@types/node": "^25.0.3",
    "@types/superagent": "^8.1.9",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.7.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.17",
    "@aws-sdk/credential-providers": "^3.1081.0",
    "@nestjs/common": "^11.1.11",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.11",
    "@nestjs/platform-express": "^11.1.11",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/client": "^6.19.1",
    "ai": "^7.0.22",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^17.2.3",
    "http-status-codes": "^2.3.0",
    "lodash": "^4.17.21",
    "pg": "^8.16.3",
    "prisma": "^6.19.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "superagent": "^10.3.0",
    "tc-core-library-js": "github:topcoder-platform/tc-core-library-js#master",
    "winston": "^3.19.0"
  }
}
